{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diginix",
  "compatibility_date": "2026-06-28",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.js"
}