{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diginix",
  "compatibility_date": "2026-06-28",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/blog/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.js"
}